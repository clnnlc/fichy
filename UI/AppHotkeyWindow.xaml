<Window x:Class="VolumeMixer.UI.AppHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VolumeMixer.UI"
        Title="fichy — hotkeys" SizeToContent="Height" Width="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource BgBrush}" CornerRadius="14" Margin="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="20,18,20,18">
            <TextBlock x:Name="HeaderText" Text="Hotkeys" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="SubText" Text="" FontSize="11.5" Margin="0,2,0,14"
                       Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Louder" FontSize="11.5" Margin="2,0,0,4"
                               Foreground="{StaticResource SubtleBrush}"/>
                    <ui:HotkeyBox x:Name="UpBox" Style="{StaticResource FlatButton}"
                                  HorizontalAlignment="Stretch" MinWidth="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="Quieter" FontSize="11.5" Margin="2,0,0,4"
                               Foreground="{StaticResource SubtleBrush}"/>
                    <ui:HotkeyBox x:Name="DownBox" Style="{StaticResource FlatButton}"
                                  HorizontalAlignment="Stretch" MinWidth="0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                    <TextBlock Text="Mute" FontSize="11.5" Margin="2,0,0,4"
                               Foreground="{StaticResource SubtleBrush}"/>
                    <ui:HotkeyBox x:Name="MuteBox" Style="{StaticResource FlatButton}"
                                  HorizontalAlignment="Stretch" MinWidth="0"/>
                </StackPanel>
            </Grid>

            <DockPanel Margin="0,14,0,0">
                <TextBlock Text="Step" VerticalAlignment="Center" DockPanel.Dock="Left"
                           Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                <TextBox x:Name="StepBox" Style="{StaticResource DarkTextBox}" Width="52"
                         TextAlignment="Center" DockPanel.Dock="Left" Margin="8,0,4,0"/>
                <TextBlock Text="%" VerticalAlignment="Center" DockPanel.Dock="Left"
                           Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           MaxWidth="230"/>
            </DockPanel>

            <TextBlock Text="Click a field and press your combination — any mix of Ctrl / Alt / Shift / Win. Backspace clears, Esc cancels."
                       FontSize="11" Foreground="{StaticResource SubtleBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="16"/>

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource FlatButton}"
                        DockPanel.Dock="Left" Padding="14,7" Click="Remove_Click"/>
                <Button Content="Save" Style="{StaticResource AccentButton}"
                        DockPanel.Dock="Right" Padding="18,7" Click="Save_Click"/>
                <Button Content="Cancel" Style="{StaticResource FlatButton}"
                        DockPanel.Dock="Right" Margin="0,0,8,0" Padding="14,7" Click="Cancel_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

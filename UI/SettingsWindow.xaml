<Window x:Class="VolumeMixer.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VolumeMixer.UI"
        Title="fichy — Settings"
        Width="660" Height="780" MinWidth="560" MinHeight="480"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- General -->
                <TextBlock Text="General" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,22">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Open / close overlay" FontWeight="SemiBold"/>
                                <TextBlock Text="Global hotkey to show/hide the mixer"
                                           Foreground="{StaticResource SubtleBrush}" FontSize="11.5"/>
                            </StackPanel>
                            <ui:HotkeyBox x:Name="OverlayHotkeyBox" Style="{StaticResource FlatButton}"
                                          DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <CheckBox x:Name="AutostartCheck" Content="Start automatically with Windows"
                                  Foreground="{StaticResource TextBrush}" Margin="0,4" FontSize="13"/>
                        <CheckBox x:Name="FocusLostCheck" Content="Close the overlay when it loses focus"
                                  Foreground="{StaticResource TextBrush}" Margin="0,4" FontSize="13"/>

                        <CheckBox x:Name="RememberCheck" Margin="0,4" FontSize="13"
                                  Foreground="{StaticResource TextBrush}">
                            <StackPanel>
                                <TextBlock Text="Remember each app's volume"/>
                                <TextBlock Foreground="{StaticResource SubtleBrush}" FontSize="11.5"
                                           TextWrapping="Wrap" MaxWidth="470"
                                           Text="Players like Spotify or Amazon Music open a new audio session for every track, which always starts at 100%. This restores your level automatically."/>
                            </StackPanel>
                        </CheckBox>

                        <Button x:Name="ForgetButton" Content="Forget remembered volumes"
                                Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                Margin="24,6,0,0" Padding="10,5" FontSize="12"
                                Click="Forget_Click"/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Default volume step per key press"
                                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="StepBox" Style="{StaticResource DarkTextBox}" Width="56"
                                         TextAlignment="Center"/>
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Per-app hotkeys -->
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock Text="Per-app hotkeys" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                    <Button x:Name="AddBindingButton" Content="＋ Add program"
                            Style="{StaticResource AccentButton}" DockPanel.Dock="Right"
                            Click="AddBinding_Click"/>
                </DockPanel>

                <TextBlock Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,12" LineHeight="17">
                    Assign keys to raise/lower (and optionally mute) each program. The target is matched by its process name.<LineBreak/>
                    Click a field and press your combination — single keys or any mix of Ctrl / Alt / Shift / Win (e.g. Ctrl+Alt+Num+). Backspace clears, Esc cancels.
                </TextBlock>

                <StackPanel x:Name="BindingsPanel"/>

                <TextBlock x:Name="NoBindingsHint" Text="No per-app hotkeys yet."
                           Foreground="{StaticResource SubtleBrush}" FontSize="12.5"
                           Margin="2,4,0,0" Visibility="Collapsed"/>

                <!-- Profiles -->
                <DockPanel Margin="0,26,0,12" LastChildFill="False">
                    <TextBlock Text="Profiles" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                    <Button x:Name="AddProfileButton" Content="＋ Save current mix"
                            Style="{StaticResource AccentButton}" DockPanel.Dock="Right"
                            Click="AddProfile_Click"/>
                </DockPanel>

                <TextBlock Text="Captures the volume of everything currently playing. Assign a hotkey to switch your whole mix at once."
                           Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <StackPanel x:Name="ProfilesPanel"/>

                <TextBlock x:Name="NoProfilesHint" Text="No profiles yet."
                           Foreground="{StaticResource SubtleBrush}" FontSize="12.5"
                           Margin="2,4,0,0" Visibility="Collapsed"/>

                <!-- Updates -->
                <TextBlock Text="Updates" FontSize="18" FontWeight="Bold" Margin="0,26,0,12"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <CheckBox x:Name="UpdateCheck" Content="Check for new versions on startup"
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" FontSize="13"/>
                        <DockPanel>
                            <Button x:Name="CheckUpdateButton" Content="Check now"
                                    Style="{StaticResource FlatButton}" DockPanel.Dock="Left"
                                    Padding="14,6" Click="CheckUpdate_Click"/>
                            <Button x:Name="InstallUpdateButton" Content="Download &amp; install"
                                    Style="{StaticResource AccentButton}" DockPanel.Dock="Left"
                                    Margin="8,0,0,0" Padding="14,6" Visibility="Collapsed"
                                    Click="InstallUpdate_Click"/>
                            <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="1" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
            <Button Content="Save &amp; apply" Style="{StaticResource AccentButton}"
                    DockPanel.Dock="Right" Click="Save_Click" Padding="16,8"/>
            <Button Content="Close" Style="{StaticResource FlatButton}"
                    DockPanel.Dock="Right" Margin="0,0,10,0" Click="Close_Click" Padding="16,8"/>
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="VolumeMixer.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VolumeMixer.UI"
        Title="fichy"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        SizeToContent="Height" Width="440" WindowStartupLocation="Manual">

    <Window.Resources>
        <ui:PeakToWidthConverter x:Key="PeakToWidth"/>
        <ui:MuteGlyphConverter x:Key="MuteGlyph"/>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="16" Margin="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎧" FontSize="18" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="fichy" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="finally i can hear you" FontSize="10"
                                   Foreground="{StaticResource SubtleBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource FlatButton}"
                            Padding="9,4" FontSize="15" Click="SettingsButton_Click"
                            ToolTip="Settings"/>
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource FlatButton}"
                            Padding="9,4" FontSize="13" Margin="6,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Session list -->
            <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                    Padding="14,11" Margin="0,0,0,8"
                                    MouseWheel="Row_MouseWheel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                            Background="#1E2233" Margin="0,0,12,0">
                                        <Image Source="{Binding Icon}" Width="24" Height="24"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Name + slider + meter -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="230" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0}%}"
                                                       Foreground="{StaticResource SubtleBrush}" FontSize="12.5"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding DeviceSummary}" FontSize="10.5"
                                                   Foreground="{StaticResource SubtleBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="250"
                                                   Margin="0,0,0,4"/>

                                        <Grid>
                                            <Slider Style="{StaticResource VolumeSlider}"
                                                    Value="{Binding VolumePercent, Mode=TwoWay}"/>
                                        </Grid>

                                        <!-- Peak meter -->
                                        <Border Width="250" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                                                Background="#20FFFFFF" Margin="0,5,0,0" ClipToBounds="True">
                                            <Border HorizontalAlignment="Left" CornerRadius="2"
                                                    Background="{StaticResource AccentBrush2}"
                                                    Width="{Binding Peak, Converter={StaticResource PeakToWidth}, ConverterParameter=250}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Mute -->
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}"
                                            VerticalAlignment="Center" Margin="10,0,0,0" Padding="9,7"
                                            Click="MuteButton_Click" Tag="{Binding}"
                                            Content="{Binding IsMuted, Converter={StaticResource MuteGlyph}}"
                                            FontSize="15" ToolTip="Mute"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="No apps are playing audio.&#10;Start some playback (music or a video) and it'll show up here."
                       Foreground="{StaticResource SubtleBrush}" TextAlignment="Center"
                       Margin="0,30" Visibility="Collapsed" FontSize="13" LineHeight="20"/>

            <TextBlock Grid.Row="2" Margin="2,10,0,0" FontSize="11"
                       Foreground="{StaticResource SubtleBrush}"
                       Text="Scroll over a slider to change its volume • Esc closes"/>
        </Grid>
    </Border>
</Window>

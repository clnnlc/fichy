<Window x:Class="VolumeMixer.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" IsHitTestVisible="False">
    <Border Background="#EE1A1B26" CornerRadius="14" Padding="22,16" MinWidth="300"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                <TextBlock x:Name="Glyph" Text="🔊" FontSize="18" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBlock x:Name="LabelText" Text="Program" FontSize="15" FontWeight="SemiBold"
                           DockPanel.Dock="Left" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                <TextBlock x:Name="PercentText" Text="50%" FontSize="15" DockPanel.Dock="Right"
                           Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Height="8" CornerRadius="4" Background="{StaticResource TrackBrush}" ClipToBounds="True">
                <Border x:Name="Fill" HorizontalAlignment="Left" CornerRadius="4"
                        Background="{StaticResource AccentBrush}" Width="150"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
